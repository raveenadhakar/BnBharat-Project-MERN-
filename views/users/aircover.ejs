<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">AirCover for Hosts</h1>
    
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title" >🛡️ Comprehensive Protection for Hosts</h5>
        <p class="card-text">
          AirCover provides hosts with top-to-bottom protection, giving you peace of mind while hosting.
        </p>
      </div>
    </div>
    
    <div class="row">
      <div class="col-md-6">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Property Damage Protection</h5>
            <ul>
              <li>Coverage up to ₹20,00,000 for property damage</li>
              <li>Protection against guest-caused damages</li>
              <li>24/7 claims support</li>
              <li>Fast claim processing</li>
              <li>No deductible for most claims</li>
            </ul>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Liability Insurance</h5>
            <ul>
              <li>₹10,00,000 liability coverage</li>
              <li>Protection against third-party claims</li>
              <li>Coverage for bodily injury</li>
              <li>Property damage to neighbors</li>
              <li>Legal defense costs covered</li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="col-md-6">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Income Protection</h5>
            <ul>
              <li>Reimbursement for lost income</li>
              <li>Coverage during property repairs</li>
              <li>Alternative accommodation costs</li>
              <li>Cleaning fee reimbursement</li>
              <li>Up to 14 days of coverage</li>
            </ul>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Deep Cleaning Protection</h5>
            <ul>
              <li>Reimbursement for deep cleaning</li>
              <li>Coverage for excessive mess</li>
              <li>Professional cleaning services</li>
              <li>Sanitization costs covered</li>
              <li>Quick claim resolution</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    
    <div class="alert alert-success">
      <h6 class="alert-heading">Automatic Coverage</h6>
      <p class="mb-0">
        AirCover is automatically provided to all BnBharat hosts at no additional cost. 
        You're protected from the moment you start hosting.
      </p>
    </div>
  </div>
</div>