<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Careers</h1>
    
    <div class="hero-section mb-5">
      <div class="card bg-primary text-white">
        <div class="card-body text-center py-5">
          <h2 class="card-title" style="color: #1e56d8;">🚀 Join the BnBharat Team</h2>
          <p class="card-text lead" style="color: #444;">
            Help us revolutionize travel and hospitality in India. Build your career while making a difference.
          </p>
        </div>
      </div>
    </div>
    
    <div class="row">
      <div class="col-md-8">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Open Positions</h5>
            
            <div class="job-listing mb-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h6 class="mb-1">Senior Software Engineer - Backend</h6>
                  <p class="mb-1 text-muted">Engineering • Bangalore • Full-time</p>
                  <p class="small">Build scalable systems that power millions of bookings across India.</p>
                </div>
                <button class="btn btn-outline-primary btn-sm">Apply</button>
              </div>
            </div>
            
            <hr>
            
            <div class="job-listing mb-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h6 class="mb-1">Product Manager - Host Experience</h6>
                  <p class="mb-1 text-muted">Product • Mumbai • Full-time</p>
                  <p class="small">Lead product initiatives to improve the hosting experience and drive growth.</p>
                </div>
                <button class="btn btn-outline-primary btn-sm">Apply</button>
              </div>
            </div>
            
            <hr>
            
            <div class="job-listing mb-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h6 class="mb-1">UX Designer</h6>
                  <p class="mb-1 text-muted">Design • Delhi • Full-time</p>
                  <p class="small">Create intuitive and delightful user experiences for our mobile and web platforms.</p>
                </div>
                <button class="btn btn-outline-primary btn-sm">Apply</button>
              </div>
            </div>
            
            <hr>
            
            <div class="job-listing mb-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h6 class="mb-1">Customer Success Manager</h6>
                  <p class="mb-1 text-muted">Customer Success • Pune • Full-time</p>
                  <p class="small">Help hosts succeed and grow their business on our platform.</p>
                </div>
                <button class="btn btn-outline-primary btn-sm">Apply</button>
              </div>
            </div>
            
            <hr>
            
            <div class="job-listing mb-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h6 class="mb-1">Data Scientist</h6>
                  <p class="mb-1 text-muted">Data & Analytics • Hyderabad • Full-time</p>
                  <p class="small">Use data to drive insights and improve user experience across the platform.</p>
                </div>
                <button class="btn btn-outline-primary btn-sm">Apply</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Why BnBharat?</h5>
            <ul class="list-unstyled">
              <li class="mb-2">
                <i class="fas fa-rocket text-primary me-2"></i>
                <strong>Fast Growth:</strong> Join a rapidly expanding startup
              </li>
              <li class="mb-2">
                <i class="fas fa-users text-success me-2"></i>
                <strong>Great Team:</strong> Work with passionate, talented people
              </li>
              <li class="mb-2">
                <i class="fas fa-chart-line text-warning me-2"></i>
                <strong>Career Growth:</strong> Rapid advancement opportunities
              </li>
              <li class="mb-2">
                <i class="fas fa-heart text-danger me-2"></i>
                <strong>Impact:</strong> Make a difference in travel and hospitality
              </li>
              <li class="mb-2">
                <i class="fas fa-home text-info me-2"></i>
                <strong>Flexibility:</strong> Remote and hybrid work options
              </li>
            </ul>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Benefits</h5>
            <ul class="small">
              <li>Competitive salary and equity</li>
              <li>Health insurance for you and family</li>
              <li>Flexible working hours</li>
              <li>Learning and development budget</li>
              <li>Free BnBharat credits for travel</li>
              <li>Team outings and events</li>
              <li>Modern office spaces</li>
            </ul>
          </div>
        </div>
        
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Don't See Your Role?</h5>
            <p class="card-text">We're always looking for talented people. Send us your resume!</p>
            <button class="btn btn-primary w-100">Send Resume</button>
            <p class="small text-center mt-2">
              <strong>Email:</strong> careers@bnbharat.com
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>