<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Explore Hosting Resources</h1>
    
    <div class="row">
      <div class="col-md-8">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">📚 Hosting Guides</h5>
            
            <div class="list-group list-group-flush">
              <a href="#" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">Getting Started as a Host</h6>
                  <small>5 min read</small>
                </div>
                <p class="mb-1">Complete guide to listing your first property on BnBharat.</p>
              </a>
              
              <a href="#" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">Photography Tips for Your Listing</h6>
                  <small>8 min read</small>
                </div>
                <p class="mb-1">How to take stunning photos that attract more bookings.</p>
              </a>
              
              <a href="#" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">Pricing Your Property Right</h6>
                  <small>6 min read</small>
                </div>
                <p class="mb-1">Strategies to maximize your earnings with competitive pricing.</p>
              </a>
              
              <a href="#" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">Creating House Rules</h6>
                  <small>4 min read</small>
                </div>
                <p class="mb-1">Essential house rules to protect your property and ensure great stays.</p>
              </a>
            </div>
          </div>
        </div>
        
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">🎥 Video Tutorials</h5>
            <div class="row">
              <div class="col-md-6">
                <div class="card mb-3">
                  <div class="card-body">
                    <h6 class="card-title">Host Onboarding</h6>
                    <p class="card-text small">Step-by-step video guide to get started</p>
                    <button class="btn btn-outline-primary btn-sm">Watch Video</button>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="card mb-3">
                  <div class="card-body">
                    <h6 class="card-title">Managing Bookings</h6>
                    <p class="card-text small">How to handle reservations and guest communication</p>
                    <button class="btn btn-outline-primary btn-sm">Watch Video</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">🏆 Host Success Metrics</h5>
            <ul class="list-unstyled">
              <li><strong>Response Rate:</strong> Aim for 90%+</li>
              <li><strong>Response Time:</strong> Within 1 hour</li>
              <li><strong>Acceptance Rate:</strong> 88%+</li>
              <li><strong>Cancellation Rate:</strong> Less than 1%</li>
              <li><strong>Overall Rating:</strong> 4.8+ stars</li>
            </ul>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">📞 Host Support</h5>
            <p class="card-text">Need help? Our host support team is available 24/7.</p>
            <button class="btn btn-primary w-100 mb-2">Contact Host Support</button>
            <p class="small text-center">
              <strong>Phone:</strong> +91-11-4567-8933<br>
              <strong>Email:</strong> hosts@bnbharat.com
            </p>
          </div>
        </div>
        
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">💡 Quick Tips</h5>
            <ul class="small">
              <li>Respond to inquiries quickly</li>
              <li>Keep your calendar updated</li>
              <li>Provide clear check-in instructions</li>
              <li>Stock essential amenities</li>
              <li>Ask for reviews after checkout</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>