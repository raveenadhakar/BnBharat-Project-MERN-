<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Visit Our Community Forum</h1>
    
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">🤝 Connect with Fellow Hosts</h5>
        <p class="card-text">
          Join thousands of hosts sharing experiences, tips, and support in our vibrant community forum.
        </p>
      </div>
    </div>
    
    <div class="row">
      <div class="col-md-8">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Popular Forum Categories</h5>
            
            <div class="list-group">
              <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">💬 General Discussion</h6>
                  <span class="badge bg-primary rounded-pill">1,234 posts</span>
                </div>
                <p class="mb-1">General hosting topics and community discussions</p>
                <small>Latest: Tips for winter hosting - 2 hours ago</small>
              </div>
              
              <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">🏠 Property Management</h6>
                  <span class="badge bg-success rounded-pill">856 posts</span>
                </div>
                <p class="mb-1">Maintenance, cleaning, and property care discussions</p>
                <small>Latest: Best cleaning services in Mumbai - 4 hours ago</small>
              </div>
              
              <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">💰 Pricing & Revenue</h6>
                  <span class="badge bg-warning rounded-pill">623 posts</span>
                </div>
                <p class="mb-1">Pricing strategies and revenue optimization</p>
                <small>Latest: Festival season pricing tips - 6 hours ago</small>
              </div>
              
              <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">👥 Guest Relations</h6>
                  <span class="badge bg-info rounded-pill">445 posts</span>
                </div>
                <p class="mb-1">Handling difficult guests and improving reviews</p>
                <small>Latest: Dealing with late checkouts - 8 hours ago</small>
              </div>
              
              <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">📸 Marketing & Photos</h6>
                  <span class="badge bg-secondary rounded-pill">312 posts</span>
                </div>
                <p class="mb-1">Photography tips and listing optimization</p>
                <small>Latest: Monsoon photography challenges - 12 hours ago</small>
              </div>
            </div>
          </div>
        </div>
        
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Recent Discussions</h5>
            <div class="list-group list-group-flush">
              <div class="list-group-item">
                <div class="d-flex align-items-start">
                  <div class="flex-shrink-0">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                      <i class="fas fa-user"></i>
                    </div>
                  </div>
                  <div class="flex-grow-1 ms-3">
                    <h6 class="mb-1">How to handle security deposits?</h6>
                    <p class="mb-1 small">Posted by @rajesh_host in Property Management</p>
                    <small class="text-muted">15 replies • Last reply 2 hours ago</small>
                  </div>
                </div>
              </div>
              
              <div class="list-group-item">
                <div class="d-flex align-items-start">
                  <div class="flex-shrink-0">
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                      <i class="fas fa-user"></i>
                    </div>
                  </div>
                  <div class="flex-grow-1 ms-3">
                    <h6 class="mb-1">Best amenities for business travelers</h6>
                    <p class="mb-1 small">Posted by @priya_mumbai in General Discussion</p>
                    <small class="text-muted">8 replies • Last reply 4 hours ago</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Forum Stats</h5>
            <ul class="list-unstyled">
              <li><strong>Total Members:</strong> 12,456</li>
              <li><strong>Total Posts:</strong> 45,678</li>
              <li><strong>Active Today:</strong> 234</li>
              <li><strong>New This Week:</strong> 89</li>
            </ul>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Top Contributors</h5>
            <div class="list-group list-group-flush">
              <div class="list-group-item d-flex justify-content-between align-items-center">
                @superhostdelhi
                <span class="badge bg-primary rounded-pill">156 posts</span>
              </div>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                @goahost2023
                <span class="badge bg-primary rounded-pill">134 posts</span>
              </div>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                @bangalorebnb
                <span class="badge bg-primary rounded-pill">98 posts</span>
              </div>
            </div>
          </div>
        </div>
        
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Join the Discussion</h5>
            <p class="card-text">Ready to connect with other hosts?</p>
            <button class="btn btn-primary w-100">Join Forum</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>