<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Cancellation Options</h1>
    
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">Understanding Cancellation Policies</h5>
        <p class="card-text">
          Each listing has its own cancellation policy set by the host. Here's what you need to know:
        </p>
      </div>
    </div>
    
    <div class="row">
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title text-success">Flexible</h5>
            <p class="card-text">
              <strong>Full refund:</strong> Cancel up to 24 hours before check-in<br>
              <strong>50% refund:</strong> Cancel within 24 hours of check-in
            </p>
            <span class="badge bg-success">Most Popular</span>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title text-warning">Moderate</h5>
            <p class="card-text">
              <strong>Full refund:</strong> Cancel up to 5 days before check-in<br>
              <strong>50% refund:</strong> Cancel within 5 days of check-in
            </p>
            <span class="badge bg-warning">Balanced</span>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title text-danger">Strict</h5>
            <p class="card-text">
              <strong>Full refund:</strong> Cancel up to 14 days before check-in<br>
              <strong>50% refund:</strong> Cancel 7-14 days before check-in<br>
              <strong>No refund:</strong> Cancel within 7 days
            </p>
            <span class="badge bg-danger">Non-flexible</span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">How to Cancel Your Booking</h5>
        <ol>
          <li>Go to your account dashboard</li>
          <li>Find your booking under "My Trips"</li>
          <li>Click "Cancel Booking"</li>
          <li>Select your reason for cancellation</li>
          <li>Confirm cancellation</li>
        </ol>
        
        <div class="alert alert-info mt-3">
          <h6 class="alert-heading">Extenuating Circumstances</h6>
          <p class="mb-0">
            In case of emergencies, natural disasters, or other extenuating circumstances, 
            special cancellation policies may apply. Contact our support team for assistance.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>