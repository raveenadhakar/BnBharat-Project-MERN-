<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Our COVID-19 Response</h1>
    
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">🦠 Health & Safety First</h5>
        <p class="card-text">
          BnBharat is committed to the health and safety of our community. Here's how we're responding to COVID-19.
        </p>
      </div>
    </div>
    
    <div class="row">
      <div class="col-md-6">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Enhanced Cleaning Protocol</h5>
            <ul>
              <li>24-hour vacancy period between bookings</li>
              <li>Use of approved disinfectants</li>
              <li>Deep cleaning of high-touch surfaces</li>
              <li>Sanitization of linens and towels</li>
              <li>Air purification systems where available</li>
            </ul>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Flexible Booking Policies</h5>
            <ul>
              <li>Extended cancellation windows</li>
              <li>Free date changes for affected bookings</li>
              <li>Travel credits for future use</li>
              <li>Waived change fees during outbreaks</li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="col-md-6">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Guest Guidelines</h5>
            <ul>
              <li>Follow local health guidelines</li>
              <li>Wear masks in common areas</li>
              <li>Maintain social distancing</li>
              <li>Report any symptoms immediately</li>
              <li>Use hand sanitizer frequently</li>
            </ul>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Host Support</h5>
            <ul>
              <li>Free cleaning supplies for verified hosts</li>
              <li>Training on enhanced cleaning protocols</li>
              <li>Financial assistance for affected hosts</li>
              <li>24/7 support for COVID-related issues</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    
    <div class="alert alert-warning">
      <h6 class="alert-heading">Stay Updated</h6>
      <p class="mb-0">
        COVID-19 guidelines are constantly evolving. Please check local health authorities 
        and government websites for the latest travel restrictions and safety protocols.
      </p>
    </div>
  </div>
</div>