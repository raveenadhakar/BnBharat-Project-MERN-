<% layout("/layouts/boilerplate") %>

    <div class="row mt-5">
        <div class="col-10 offset-1">
            <h1 class="mb-4">Supporting People with Disabilities</h1>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">♿ Accessible Travel for Everyone</h5>
                    <p class="card-text">
                        BnBharat is committed to making travel accessible for people with disabilities.
                        We believe everyone deserves the opportunity to explore and experience new places.
                    </p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title">Accessibility Features</h5>
                            <ul>
                                <li><strong>Step-free access:</strong> Properties with no stairs or steps</li>
                                <li><strong>Wide doorways:</strong> 32+ inches for wheelchair access</li>
                                <li><strong>Accessible bathroom:</strong> Roll-in showers, grab bars</li>
                                <li><strong>Accessible parking:</strong> Designated accessible parking spots</li>
                                <li><strong>Pool access:</strong> Pool lifts or step-free entry</li>
                            </ul>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title">How to Find Accessible Properties</h5>
                            <ol>
                                <li>Use our accessibility filters in search</li>
                                <li>Look for the accessibility badge on listings</li>
                                <li>Read detailed accessibility descriptions</li>
                                <li>Contact hosts directly with specific questions</li>
                                <li>Check recent reviews from other guests</li>
                            </ol>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title">Support Services</h5>
                            <ul>
                                <li>Dedicated accessibility support team</li>
                                <li>Assistance with booking accessible properties</li>
                                <li>Travel planning support</li>
                                <li>24/7 customer service</li>
                                <li>Partnership with accessibility organizations</li>
                            </ul>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Need Help?</h5>
                            <p>Our accessibility team is here to assist you.</p>
                            <button class="btn btn-primary w-100 mb-2">Contact Accessibility Team</button>
                            <p class="small text-center">
                                <strong>Phone:</strong> +91-11-4567-8922<br>
                                <strong>Email:</strong> accessibility@bnbharat.com
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>