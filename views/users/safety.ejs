<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Safety Information</h1>
    
    <div class="row">
      <div class="col-md-8">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">🛡️ Your Safety is Our Priority</h5>
            <p class="card-text">
              At BnBharat, we're committed to creating a safe and secure environment for all our users.
            </p>
            
            <h6 class="mt-4">Safety Features</h6>
            <ul>
              <li><strong>Verified Profiles:</strong> All hosts and guests undergo identity verification</li>
              <li><strong>Secure Payments:</strong> All transactions are processed through secure payment gateways</li>
              <li><strong>24/7 Support:</strong> Our safety team is available round the clock</li>
              <li><strong>Property Verification:</strong> We verify property details and photos</li>
            </ul>
            
            <h6 class="mt-4">Safety Tips for Guests</h6>
            <ul>
              <li>Read reviews and ratings before booking</li>
              <li>Communicate through our platform initially</li>
              <li>Report any suspicious activity immediately</li>
              <li>Keep important documents and valuables secure</li>
              <li>Share your travel plans with trusted contacts</li>
            </ul>
            
            <h6 class="mt-4">Safety Tips for Hosts</h6>
            <ul>
              <li>Verify guest identity before check-in</li>
              <li>Install smoke and carbon monoxide detectors</li>
              <li>Provide clear house rules and emergency information</li>
              <li>Keep property insurance up to date</li>
              <li>Report any concerning guest behavior</li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">🚨 Emergency Contacts</h5>
            <p><strong>Police:</strong> 100</p>
            <p><strong>Fire:</strong> 101</p>
            <p><strong>Ambulance:</strong> 108</p>
            <p><strong>BnBharat Safety:</strong> +91-11-4567-8911</p>
          </div>
        </div>
        
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Report an Issue</h5>
            <p class="card-text">If you encounter any safety concerns, report them immediately.</p>
            <button class="btn btn-danger w-100">Report Safety Issue</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>