<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Terms of Service</h1>
    
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Terms and Conditions</h5>
        <p class="card-text">
          Welcome to BnBharat. By using our platform, you agree to these terms and conditions.
        </p>
        
        <h6 class="mt-4">User Responsibilities</h6>
        <ul>
          <li>Provide accurate and truthful information</li>
          <li>Respect other users and their properties</li>
          <li>Follow local laws and regulations</li>
          <li>Maintain the security of your account</li>
        </ul>
        
        <h6 class="mt-4">Host Obligations</h6>
        <ul>
          <li>Provide accurate property descriptions and photos</li>
          <li>Maintain property safety and cleanliness standards</li>
          <li>Respond promptly to guest inquiries</li>
          <li>Honor confirmed bookings</li>
        </ul>
        
        <h6 class="mt-4">Guest Obligations</h6>
        <ul>
          <li>Treat properties with respect and care</li>
          <li>Follow house rules set by hosts</li>
          <li>Report any issues promptly</li>
          <li>Leave properties in good condition</li>
        </ul>
        
        <h6 class="mt-4">Cancellation Policy</h6>
        <p>
          Cancellation policies vary by listing. Please review the specific cancellation policy 
          before making a booking.
        </p>
        
        <p class="mt-4 text-muted">
          <small>Last updated: January 2025</small>
        </p>
      </div>
    </div>
  </div>
</div>