<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Investors</h1>
    
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">📈 Investor Relations</h5>
        <p class="card-text">
          Welcome to BnBharat's investor relations page. Here you'll find key information about our 
          company performance, financial reports, and growth metrics.
        </p>
      </div>
    </div>
    
    <div class="row">
      <div class="col-md-8">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Company Overview</h5>
            <p>
              BnBharat is India's fastest-growing home-sharing platform, connecting travelers with 
              unique accommodations across the country. Since our launch in 2025, we've facilitated 
              over 100,000 bookings and built a community of 25,000+ hosts.
            </p>
            
            <h6 class="mt-4">Key Metrics (Q4 2024)</h6>
            <div class="row">
              <div class="col-md-6">
                <ul>
                  <li><strong>Total Bookings:</strong> 125,000+</li>
                  <li><strong>Active Hosts:</strong> 28,500</li>
                  <li><strong>Cities Covered:</strong> 150+</li>
                  <li><strong>Gross Booking Value:</strong> ₹450 Crores</li>
                </ul>
              </div>
              <div class="col-md-6">
                <ul>
                  <li><strong>Monthly Growth:</strong> 25%</li>
                  <li><strong>Host Retention:</strong> 89%</li>
                  <li><strong>Guest Satisfaction:</strong> 4.7/5</li>
                  <li><strong>Market Share:</strong> 15%</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Recent Funding</h5>
            
            <div class="timeline">
              <div class="timeline-item mb-3">
                <div class="d-flex">
                  <div class="flex-shrink-0">
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                      <small>A</small>
                    </div>
                  </div>
                  <div class="flex-grow-1 ms-3">
                    <h6 class="mb-1">Series A - ₹200 Crores</h6>
                    <p class="mb-1 small">Led by Sequoia Capital India, with participation from Accel Partners</p>
                    <small class="text-muted">December 2024</small>
                  </div>
                </div>
              </div>
              
              <div class="timeline-item mb-3">
                <div class="d-flex">
                  <div class="flex-shrink-0">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                      <small>S</small>
                    </div>
                  </div>
                  <div class="flex-grow-1 ms-3">
                    <h6 class="mb-1">Seed Round - ₹50 Crores</h6>
                    <p class="mb-1 small">Led by Matrix Partners India, with angel investors</p>
                    <small class="text-muted">June 2024</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Financial Reports</h5>
            <div class="list-group list-group-flush">
              <a href="#" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">Q4 2024 Report</h6>
                  <small>PDF</small>
                </div>
                <p class="mb-1 small">Quarterly financial and operational metrics</p>
              </a>
              
              <a href="#" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">Annual Report 2024</h6>
                  <small>PDF</small>
                </div>
                <p class="mb-1 small">Complete annual performance review</p>
              </a>
              
              <a href="#" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                  <h6 class="mb-1">Investor Deck</h6>
                  <small>PDF</small>
                </div>
                <p class="mb-1 small">Company overview and growth strategy</p>
              </a>
            </div>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Board of Directors</h5>
            <ul class="list-unstyled small">
              <li class="mb-2">
                <strong>Rahul Sharma</strong><br>
                Co-founder & CEO
              </li>
              <li class="mb-2">
                <strong>Priya Patel</strong><br>
                Co-founder & CTO
              </li>
              <li class="mb-2">
                <strong>Ravi Adusumalli</strong><br>
                Managing Director, Sequoia Capital India
              </li>
              <li class="mb-2">
                <strong>Anand Daniel</strong><br>
                Partner, Accel Partners
              </li>
            </ul>
          </div>
        </div>
        
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Investor Contact</h5>
            <p class="card-text">
              <strong>Investor Relations:</strong><br>
              investors@bnbharat.com<br>
              +91-11-4567-8955
            </p>
            <p class="card-text">
              <strong>Media Inquiries:</strong><br>
              press@bnbharat.com
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>