<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Sitemap</h1>
    
    <div class="row">
      <div class="col-md-6">
        <div class="card mb-4">
          <div class="card-header">
            <h5 class="mb-0">Main Pages</h5>
          </div>
          <div class="card-body">
            <ul class="list-unstyled">
              <li><a href="/listings" class="text-decoration-none">🏠 All Listings</a></li>
              <li><a href="/listings/new" class="text-decoration-none">➕ Add New Listing</a></li>
              <li><a href="/listings/liked" class="text-decoration-none">❤️ Liked Listings</a></li>
            </ul>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-header">
            <h5 class="mb-0">User Account</h5>
          </div>
          <div class="card-body">
            <ul class="list-unstyled">
              <li><a href="/register" class="text-decoration-none">📝 Register</a></li>
              <li><a href="/login" class="text-decoration-none">🔐 Login</a></li>
              <li><a href="/logout" class="text-decoration-none">🚪 Logout</a></li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="col-md-6">
        <div class="card mb-4">
          <div class="card-header">
            <h5 class="mb-0">Legal & Support</h5>
          </div>
          <div class="card-body">
            <ul class="list-unstyled">
              <li><a href="/privacy" class="text-decoration-none">🔒 Privacy Policy</a></li>
              <li><a href="/terms" class="text-decoration-none">📋 Terms of Service</a></li>
              <li><a href="/details" class="text-decoration-none">🏢 Company Details</a></li>
              <li><a href="/sitemap" class="text-decoration-none">🗺️ Sitemap</a></li>
            </ul>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-header">
            <h5 class="mb-0">Social Media</h5>
          </div>
          <div class="card-body">
            <ul class="list-unstyled">
              <li><i class="fa-brands fa-square-facebook me-2"></i>Facebook</li>
              <li><i class="fa-brands fa-square-x-twitter me-2"></i>Twitter</li>
              <li><i class="fa-brands fa-square-instagram me-2"></i>Instagram</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    
    <div class="alert alert-info mt-4">
      <h6 class="alert-heading">Need Help?</h6>
      <p class="mb-0">
        If you can't find what you're looking for, please contact our support team at 
        <strong>support@bnbharat.com</strong> or call us at <strong>+91-11-4567-8900</strong>.
      </p>
    </div>
  </div>
</div>