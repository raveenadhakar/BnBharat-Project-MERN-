<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Learn About New Features</h1>
    
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">🚀 What's New at BnBharat</h5>
        <p class="card-text">
          Discover the latest features and improvements we've made to enhance your hosting and travel experience.
        </p>
      </div>
    </div>
    
    <div class="row">
      <div class="col-md-6">
        <div class="card mb-4">
          <div class="card-body">
            <div class="d-flex align-items-center mb-3">
              <span class="badge bg-success me-2">NEW</span>
              <h5 class="card-title mb-0">Smart Check-in</h5>
            </div>
            <p class="card-text">
              Contactless check-in with digital keys and automated instructions. 
              Guests can access properties seamlessly without host intervention.
            </p>
            <small class="text-muted">Released: January 2025</small>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <div class="d-flex align-items-center mb-3">
              <span class="badge bg-primary me-2">UPDATED</span>
              <h5 class="card-title mb-0">Enhanced Search Filters</h5>
            </div>
            <p class="card-text">
              More precise search options including accessibility features, 
              work-friendly spaces, and pet-friendly properties.
            </p>
            <small class="text-muted">Updated: December 2024</small>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <div class="d-flex align-items-center mb-3">
              <span class="badge bg-warning me-2">BETA</span>
              <h5 class="card-title mb-0">AI-Powered Recommendations</h5>
            </div>
            <p class="card-text">
              Personalized property recommendations based on your travel history 
              and preferences using machine learning.
            </p>
            <small class="text-muted">Beta Release: January 2025</small>
          </div>
        </div>
      </div>
      
      <div class="col-md-6">
        <div class="card mb-4">
          <div class="card-body">
            <div class="d-flex align-items-center mb-3">
              <span class="badge bg-info me-2">IMPROVED</span>
              <h5 class="card-title mb-0">Mobile App 2.0</h5>
            </div>
            <p class="card-text">
              Completely redesigned mobile experience with faster booking, 
              better navigation, and offline property details.
            </p>
            <small class="text-muted">Released: December 2024</small>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <div class="d-flex align-items-center mb-3">
              <span class="badge bg-success me-2">NEW</span>
              <h5 class="card-title mb-0">Group Booking Tools</h5>
            </div>
            <p class="card-text">
              Special features for group bookings including split payments, 
              group messaging, and coordinated check-ins.
            </p>
            <small class="text-muted">Released: January 2025</small>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <div class="d-flex align-items-center mb-3">
              <span class="badge bg-secondary me-2">COMING SOON</span>
              <h5 class="card-title mb-0">Virtual Property Tours</h5>
            </div>
            <p class="card-text">
              360-degree virtual tours and AR features to explore properties 
              before booking. Expected launch in March 2025.
            </p>
            <small class="text-muted">Expected: March 2025</small>
          </div>
        </div>
      </div>
    </div>
    
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">🔔 Stay Updated</h5>
        <p class="card-text">
          Want to be the first to know about new features? Subscribe to our updates!
        </p>
        <div class="row">
          <div class="col-md-8">
            <input type="email" class="form-control" placeholder="Enter your email address">
          </div>
          <div class="col-md-4">
            <button class="btn btn-primary w-100">Subscribe</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>