<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Newsroom</h1>
    
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">📰 Latest News from BnBharat</h5>
        <p class="card-text">
          Stay updated with the latest announcements, product updates, and company news.
        </p>
      </div>
    </div>
    
    <div class="row">
      <div class="col-md-8">
        <div class="card mb-4">
          <div class="card-body">
            <span class="badge bg-primary mb-2">Press Release</span>
            <h5 class="card-title">BnBharat Launches Enhanced Safety Features</h5>
            <p class="card-text">
              New safety protocols and verification systems to ensure secure stays for all users.
            </p>
            <small class="text-muted">January 15, 2025</small>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <span class="badge bg-success mb-2">Product Update</span>
            <h5 class="card-title">Introducing Smart Pricing for Hosts</h5>
            <p class="card-text">
              AI-powered pricing recommendations to help hosts maximize their earnings.
            </p>
            <small class="text-muted">January 10, 2025</small>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <span class="badge bg-warning mb-2">Company News</span>
            <h5 class="card-title">BnBharat Expands to 50 New Cities</h5>
            <p class="card-text">
              Bringing unique travel experiences to more destinations across India.
            </p>
            <small class="text-muted">January 5, 2025</small>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <span class="badge bg-info mb-2">Partnership</span>
            <h5 class="card-title">Strategic Partnership with Tourism Boards</h5>
            <p class="card-text">
              Collaborating with state tourism boards to promote local destinations.
            </p>
            <small class="text-muted">December 28, 2024</small>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Media Kit</h5>
            <p class="card-text">Download our media kit for logos, brand guidelines, and company information.</p>
            <button class="btn btn-outline-primary w-100">Download Media Kit</button>
          </div>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Press Contacts</h5>
            <p class="card-text">
              <strong>Media Relations:</strong><br>
              press@bnbharat.com<br>
              +91-11-4567-8944
            </p>
            <p class="card-text">
              <strong>Partnership Inquiries:</strong><br>
              partnerships@bnbharat.com
            </p>
          </div>
        </div>
        
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Follow Us</h5>
            <div class="d-grid gap-2">
              <button class="btn btn-outline-primary">
                <i class="fab fa-twitter me-2"></i>Twitter
              </button>
              <button class="btn btn-outline-primary">
                <i class="fab fa-linkedin me-2"></i>LinkedIn
              </button>
              <button class="btn btn-outline-primary">
                <i class="fab fa-instagram me-2"></i>Instagram
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>