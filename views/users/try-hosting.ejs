<style>
  .highlight-title {
    color: white;
    background-color: #333;
    padding: 10px;
    border-radius: 6px;
  }
  .highlight-text {
    color: #f5f5f5;
    background-color: #555;
    padding: 8px;
    border-radius: 4px;
  }
</style>
<% layout("/layouts/boilerplate") %>


<div class="row mt-5">
  <div class="col-10 offset-1">
    <h1 class="mb-4">Try Hosting</h1>
    
    <div class="hero-section text-center mb-5">
      <div class="card bg-primary text-white">
        <div class="card-body py-5">
          <h2 class="card-title" style="color: #1e56d8;">🏠 Become a Host Today</h2>
          <p class="card-text lead" style="color: #444;">
            Share your space and earn extra income while meeting travelers from around the world.
          </p>
          <a href="/listings/new" class="btn btn-light btn-lg">Start Hosting</a>
        </div>
      </div>
    </div>
    
    <div class="row">
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body text-center">
            <i class="fas fa-rupee-sign fa-3x text-success mb-3"></i>
            <h5 class="card-title">Earn Extra Income</h5>
            <p class="card-text">
              Hosts in India earn an average of ₹15,000-₹30,000 per month by sharing their space.
            </p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body text-center">
            <i class="fas fa-users fa-3x text-primary mb-3"></i>
            <h5 class="card-title">Meet New People</h5>
            <p class="card-text">
              Connect with travelers from different cultures and create lasting friendships.
            </p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body text-center">
            <i class="fas fa-calendar fa-3x text-warning mb-3"></i>
            <h5 class="card-title">Flexible Schedule</h5>
            <p class="card-text">
              Host on your own terms. You control when your space is available.
            </p>
          </div>
        </div>
      </div>
    </div>
    
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Getting Started is Easy</h5>
        <div class="row">
          <div class="col-md-3 text-center">
            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">1</div>
            <h6>List Your Space</h6>
            <p class="small">Add photos and details about your property</p>
          </div>
          <div class="col-md-3 text-center">
            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">2</div>
            <h6>Set Your Price</h6>
            <p class="small">Choose competitive pricing for your area</p>
          </div>
          <div class="col-md-3 text-center">
            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">3</div>
            <h6>Welcome Guests</h6>
            <p class="small">Provide great hospitality and earn reviews</p>
          </div>
          <div class="col-md-3 text-center">
            <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">4</div>
            <h6>Get Paid</h6>
            <p class="small">Receive payments securely after each stay</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>