<% layout("/layouts/boilerplate") %>

    <!-- Clean Filter Bar -->
    <div class="container-fluid px-5 py-3 filter-bar-wrapper">
        <div class="d-flex align-items-center justify-content-between">

            <!-- Essential Filter Icons -->
            <div class="d-flex align-items-center gap-4 flex-grow-1 justify-content-center">
                <div class="filter-icon <%= (filters && filters.sortBy === 'newest') ? 'active' : '' %>"
                    onclick="quickFilter('trending')">
                    <div class="icon-container"><i class="fa-solid fa-fire"></i></div>
                    <p class="filter-label">Trending</p>
                </div>
                <div class="filter-icon <%= (filters && filters.propertyType === 'Hostel Bed') ? 'active' : '' %>"
                    onclick="quickFilter('hostels')">
                    <div class="icon-container"><i class="fa-solid fa-bed"></i></div>
                    <p class="filter-label">Hostels</p>
                </div>
                <div class="filter-icon <%= (filters && filters.propertyType === 'Apartment') ? 'active' : '' %>"
                    onclick="quickFilter('apartments')">
                    <div class="icon-container"><i class="fa-solid fa-building"></i></div>
                    <p class="filter-label">Apartments</p>
                </div>
                <div class="filter-icon <%= (filters && filters.propertyType === 'Villa') ? 'active' : '' %>"
                    onclick="quickFilter('villas')">
                    <div class="icon-container"><i class="fa-solid fa-home"></i></div>
                    <p class="filter-label">Villas</p>
                </div>
                <div class="filter-icon <%= (filters && filters.propertyType === 'Cabin') ? 'active' : '' %>"
                    onclick="quickFilter('cabins')">
                    <div class="icon-container"><i class="fa-solid fa-tree"></i></div>
                    <p class="filter-label">Cabins</p>
                </div>
                <div class="filter-icon <%= (filters && filters.propertyType === 'Homestay') ? 'active' : '' %>"
                    onclick="quickFilter('homestays')">
                    <div class="icon-container"><i class="fa-solid fa-house-user"></i></div>
                    <p class="filter-label">Homestays</p>
                </div>
                <div class="filter-icon <%= (filters && filters.hasDiscount) ? 'active' : '' %>"
                    onclick="quickFilter('discounted')">
                    <div class="icon-container"><i class="fa-solid fa-tag"></i></div>
                    <p class="filter-label">Deals</p>
                </div>
            </div>

            <!-- Results Count -->
            <div class="results-count ms-4">
                <span class="text-muted"><%= totalResults || allListings.length %> properties</span>
            </div>

        </div>
    </div>

    <!-- Listings Grid -->
    <div class="container mt-3">
        <% if (allListings && allListings.length > 0) { %>
            <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 row-cols-1 g-4">
                <% for(let listing of allListings) { %>
                    <div class="col">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <div class="card">
                                <img src="<%= listing.images[0].url %>" class="card-img-top" alt="listing_image"
                                    style="height: 250px; object-fit: cover; border-radius: 0.5rem;">
                                <div class="card-img-overlay d-flex justify-content-end align-items-start p-2">
                                    <div class="favorite-icon <%= userLiked.includes(listing._id.toString()) ? 'active' : '' %>"
                                        data-id="<%= listing._id %>">♥</div>
                                </div>
                                <div class="card-body">
                                    <p class="card-text">
                                        <b><%= listing.title %></b><br>
                                        <% if (listing.discount && listing.discount > 0) { %>
                                            <% const discountedPrice = listing.price - (listing.price * listing.discount / 100); %>
                                            <span class="text-decoration-line-through text-muted">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                                            <span class="fw-bold text-success">&#8377;<%= Math.round(discountedPrice).toLocaleString("en-IN") %></span>/night
                                            <span class="badge bg-danger ms-1"><%= listing.discount %>% OFF</span>
                                        <% } else { %>
                                            &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="no-results text-center py-5">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No properties found</h4>
                <p class="text-muted">Try a different category.</p>
                <a href="/listings" class="btn btn-dark mt-2">View All Listings</a>
            </div>
        <% } %>
    </div>

    <script>
        // Like/Favorite functionality
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.favorite-icon').forEach(heart => {
                heart.addEventListener('click', async (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    const listingId = heart.dataset.id;
                    const res = await fetch(`/listings/${listingId}/like`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();
                    heart.classList.toggle('active', data.liked);
                });
            });
        });

        // Quick filter by category
        function quickFilter(category) {
            const urls = {
                'trending':   '/listings?sortBy=newest',
                'hostels':    '/listings?propertyType=Hostel Bed',
                'apartments': '/listings?propertyType=Apartment',
                'villas':     '/listings?propertyType=Villa',
                'cabins':     '/listings?propertyType=Cabin',
                'homestays':  '/listings?propertyType=Homestay',
                'discounted': '/listings?hasDiscount=on&sortBy=price_low'
            };
            window.location.href = urls[category] || '/listings';
        }
    </script>
