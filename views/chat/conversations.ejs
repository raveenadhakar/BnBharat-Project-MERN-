<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
    <h3 class="fw-bold mb-4"><i class="fas fa-comments me-2"></i>Messages</h3>

    <% if (conversations.length === 0) { %>
        <div class="text-center py-5">
            <i class="fas fa-comment-slash fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No conversations yet</h5>
        </div>
    <% } else { %>
        <div class="list-group">
            <% conversations.forEach(conv => { %>
                <a href="/chat/<%= conv._id %>" class="list-group-item list-group-item-action p-3">
                    <div class="d-flex align-items-center gap-3">
                        <% if (conv.listing.images && conv.listing.images[0]) { %>
                            <img src="<%= conv.listing.images[0].url %>" class="rounded" width="55" height="55" style="object-fit: cover;">
                        <% } %>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <h6 class="mb-0 fw-semibold"><%= conv.listing.title %></h6>
                                <small class="text-muted"><%= new Date(conv.lastTime).toLocaleDateString() %></small>
                            </div>
                            <p class="small text-muted mb-0 text-truncate"><%= conv.lastMessage %></p>
                        </div>
                        <% if (conv.unread > 0) { %>
                            <span class="badge bg-danger rounded-pill"><%= conv.unread %></span>
                        <% } %>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } %>
</div>
