<!-- Navbar (responsive for both desktop and mobile) -->
<nav class="navbar navbar-expand-md bg-white shadow-sm sticky-top px-3">
  <div class="container-fluid">
    <!-- Logo/Brand -->
    <a class="navbar-brand fw-bold" href="/listings">
      <i class="fa-regular fa-compass me-2"></i>BnBharat
    </a>

    <!-- Toggle button for mobile view only (visible on small screens) -->
    <button class="btn d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sideMenu" aria-controls="sideMenu">
      <i class="fa-solid fa-bars fs-4"></i>
    </button>

    <!-- Navbar links for desktop (visible on medium and larger screens) -->
    <div class="collapse navbar-collapse justify-content-end">
      <div class="navbar-nav gap-2">
        <a class="nav-link" href="/listings/new">Host with BharatBnB</a>
