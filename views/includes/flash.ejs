<% if(success && success.length>0) { %>
<!-- Toast Alert -->
<div class="toast-wrapper" id="successToast">
  <div class="toast-success">
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-check" fill="none" viewBox="0 0 24 24" stroke="#15803d">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span><%= success %></span>
    <button class="close-btn" onclick="document.getElementById('customToast').style.display='none'">×</button>
  </div>
</div>
<% } %>

<% if (error && error.length > 0) { %>
<div class="alert alert-danger alert-dismissible fade show col-4 offset-4" role="alert">
    <%= error[0] %> <!-- show the first flash error -->
    <button 
        type="button" 
        class="btn-close" 
        data-bs-dismiss="alert" 
        aria-label="Close">
    </button>
</div>
<% } %>

<script>
setTimeout(() => {
  const toast = document.getElementById('successToast');
  if (toast) toast.style.display = 'none';

}, 3000);
</script>

<style>
.toast-wrapper {
  display: flex;
  justify-content: center;
  margin-top: 16px;
}

.toast-success {
  background-color: #f0fdf4;
  color: #15803d;
  border: 1px solid #f2fff6;
  padding: 12px 20px;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  font-size: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  animation: fadeIn 0.3s ease-in-out;
}

.toast-success .close-btn {
  background: transparent;
  border: none;
  color: #15803d;
  font-size: 20px;
  font-weight: bold;
  cursor: pointer;
}

.toast-success .icon-check {
  height: 20px;
  width: 20px;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
